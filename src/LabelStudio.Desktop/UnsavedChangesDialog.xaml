<Window x:Class="LabelStudio.Desktop.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved Changes" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#FFF8F6F7" Foreground="#FF282331"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#FF282331"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF625866"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF8B818D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC63F78"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF982557"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF5E0EA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF8F6F7"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FFD8D0D6"/>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="MinWidth" Value="116"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="24,22,24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AccentSoftBrush}">
                    <TextBlock Text="!" Foreground="{StaticResource AccentBrush}" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="UNSAVED CHANGES" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock Text="Keep your latest edits?" Foreground="{StaticResource TextBrush}" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="This label has changes that have not been saved. Save them before closing, or discard them and continue."
                       TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12" LineHeight="18"
                       Margin="0,18,0,22"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" Click="OnCancel"/>
                <Button Content="Discard" Style="{StaticResource DialogButton}" Click="OnDiscard"/>
                <Button Content="Save changes" Style="{StaticResource PrimaryDialogButton}" IsDefault="True" Click="OnSave"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
