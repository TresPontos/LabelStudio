<Window x:Class="LabelStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="LabelStudio" Height="820" Width="1280"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#FFE0DDE0"
        Foreground="#FF282331"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="MainWindow_OnLoaded"
        Closing="MainWindow_OnClosing"
        KeyDown="MainWindow_OnKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#FF282331"/>
        <SolidColorBrush x:Key="InkSoftBrush" Color="#FF5B5262"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FF282331"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF625866"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF8B818D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC63F78"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF982557"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF5E0EA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF8F6F7"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFF0ECEF"/>
        <SolidColorBrush x:Key="WorkspaceBrush" Color="#FFE0DDE0"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FFD8D0D6"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#FFD0C6CE"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF4B8A70"/>
        <SolidColorBrush x:Key="TransparentBrush" Color="#00000000"/>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="4,5"/>
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
        </Style>
        <Style x:Key="PrimaryToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Width" Value="78"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RollButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="218"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF0C9DC"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="3,5"/>
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
        </Style>
        <Style x:Key="InspectorActionButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        </Style>
        <Style x:Key="ToolbarCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="ToolbarGlyph" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="InspectorLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style x:Key="InspectorField" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="ContextField" TargetType="TextBox" BasedOn="{StaticResource InspectorField}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
        <Style x:Key="ContextCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="126"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="ContextCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="ItemChrome" Property="BorderThickness" Value="1,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource WorkspaceBrush}">
        <!-- Native-style application menu -->
        <Border DockPanel.Dock="Top" Height="28" Background="{StaticResource InkBrush}">
            <Grid>
                <TextBlock Text="LABELSTUDIO" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="#FFEEDFE7" FontSize="10" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                    <TextBlock Text="File" Margin="16,0" VerticalAlignment="Center" Foreground="#FFE8DDE4" FontSize="11"/>
                    <TextBlock Text="Edit" Margin="16,0" VerticalAlignment="Center" Foreground="#FFE8DDE4" FontSize="11"/>
                    <TextBlock Text="View" Margin="16,0" VerticalAlignment="Center" Foreground="#FFE8DDE4" FontSize="11"/>
                    <TextBlock Text="Insert" Margin="16,0" VerticalAlignment="Center" Foreground="#FFE8DDE4" FontSize="11"/>
                    <TextBlock Text="Format" Margin="16,0" VerticalAlignment="Center" Foreground="#FFE8DDE4" FontSize="11"/>
                    <TextBlock Text="Layout" Margin="16,0" VerticalAlignment="Center" Foreground="#FFE8DDE4" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Document identity -->
        <Border DockPanel.Dock="Top" Height="72" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="218"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LabelStudio" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="LABEL DESIGNER  /  BROTHER QL" FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="1,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock x:Name="DocumentNameLabel" Text="Untitled label" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Label design  •  ready to print" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="ChangeRollButton" Click="OnChangeMedia"
                        Style="{StaticResource RollButton}" Cursor="Hand"
                        ToolTip="Change label stock without removing artwork">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="CHANGE ROLL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="DocumentMediaLabel" Text="DK-22251  •  62 mm continuous" FontSize="11"
                                       Foreground="{StaticResource AccentDarkBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="›" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="25"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,2,2"/>
                    </Grid>
                </Button>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/>
                    <TextBlock Text="QL-800 READY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Command strip -->
        <Border DockPanel.Dock="Top" Height="76" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button Style="{StaticResource ToolbarButton}" Click="OnThermalPreview" ToolTip="Thermal Preview">
                        <StackPanel><TextBlock Text="◉" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Preview" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnMockPrint" ToolTip="Mock Print to File">
                        <StackPanel><TextBlock Text="▤" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Mock print" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryToolbarButton}" Click="OnPrint" ToolTip="Physical Print">
                        <StackPanel><TextBlock Text="▶" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Print" Foreground="White" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                    </Button>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <StackPanel Orientation="Horizontal">
                    <Border x:Name="TextContextPanel" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="9,5" Margin="0,0,8,0" VerticalAlignment="Center"
                            ToolTip="Select a text object to edit its common formatting here">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="TEXT" Style="{StaticResource ContextCaption}"/>
                                <TextBlock x:Name="ContextTextStatus" Text="Select text to format" FontSize="10"
                                           Foreground="{StaticResource AccentDarkBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="ContextFontFamilyCombo" Style="{StaticResource ContextCombo}"
                                      IsEditable="True" ToolTip="Font family"
                                      SelectionChanged="OnContextFontFamilyChanged"
                                      LostFocus="OnContextFontFamilyLostFocus">
                                <ComboBoxItem Content="Segoe UI"/>
                                <ComboBoxItem Content="Arial"/>
                                <ComboBoxItem Content="Calibri"/>
                                <ComboBoxItem Content="Bahnschrift"/>
                                <ComboBoxItem Content="Consolas"/>
                            </ComboBox>
                            <Button Style="{StaticResource CompactButton}" Width="26" Height="28" Content="−"
                                    Click="OnContextFontSizeDown" ToolTip="Decrease text size"/>
                            <TextBox x:Name="ContextFontSizeBox" Style="{StaticResource ContextField}" Width="52"
                                     Text="12" TextAlignment="Center" ToolTip="Font size in points"
                                     LostFocus="OnContextFontSizeLostFocus" KeyDown="OnContextFontSizeKeyDown"/>
                            <Button Style="{StaticResource CompactButton}" Width="26" Height="28" Content="+"
                                    Click="OnContextFontSizeUp" ToolTip="Increase text size"/>
                            <TextBlock Text="pt" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                       VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButton}" Click="OnNew" ToolTip="New (Ctrl+N)">
                        <StackPanel><TextBlock Text="+" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="New" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnOpen" ToolTip="Open (Ctrl+O)">
                        <StackPanel><TextBlock Text="□" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Open" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnSave" ToolTip="Save (Ctrl+S)">
                        <StackPanel><TextBlock Text="▣" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Save" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnSaveAs" ToolTip="Save As (Ctrl+Shift+S)">
                        <StackPanel><TextBlock Text="↗" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Save as" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                    </Button>
                    </StackPanel>
                    <Border Width="1" Margin="8,10" Background="{StaticResource DividerBrush}"/>
                    <StackPanel Orientation="Horizontal">
                    <Button x:Name="UndoBtn" Style="{StaticResource ToolbarButton}" Click="OnUndo" ToolTip="Undo (Ctrl+Z)">
                        <StackPanel><TextBlock Text="↶" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Undo" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                    </Button>
                    <Button x:Name="RedoBtn" Style="{StaticResource ToolbarButton}" Click="OnRedo" ToolTip="Redo (Ctrl+Y)">
                        <StackPanel><TextBlock Text="↷" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Redo" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                    </Button>
                    </StackPanel>
                    <Border Width="1" Margin="8,10" Background="{StaticResource DividerBrush}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CompactButton}" Content="−" Click="OnZoomOut" ToolTip="Zoom out"/>
                    <TextBlock x:Name="ZoomLabel" Text="100%" MinWidth="45" TextAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <Button Style="{StaticResource CompactButton}" Content="+" Click="OnZoomIn" ToolTip="Zoom in"/>
                    <Button Style="{StaticResource CompactButton}" Content="Fit" Click="OnZoomFit" ToolTip="Zoom to fit" FontSize="11"/>
                    <Border Width="1" Height="26" Margin="8,0" Background="{StaticResource DividerBrush}"/>
                    <Button Style="{StaticResource CompactButton}" Content="⟲" Click="OnRotateViewLeft" ToolTip="Rotate canvas view left. Does not change label printing."/>
                    <TextBlock x:Name="ViewRotationLabel" Text="0°" MinWidth="28" TextAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <Button Style="{StaticResource CompactButton}" Content="⟳" Click="OnRotateViewRight" ToolTip="Rotate canvas view right. Does not change label printing."/>
                    <Border Width="1" Height="26" Margin="8,0" Background="{StaticResource DividerBrush}"/>
                    <Button x:Name="SnapToggle" Content="Snap: ON" Click="OnSnapToggle"
                            Style="{StaticResource CompactButton}" MinWidth="68" ToolTip="Toggle snapping. Hold Alt while dragging to bypass."/>
                    <CheckBox x:Name="ShowGridToggle" Content="Grid" IsChecked="True" Click="OnShowGridToggle"
                              VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="GridSpacingCombo" Width="58" Height="24" SelectionChanged="OnGridSpacingChanged"
                               ToolTip="Grid spacing">
                        <ComboBoxItem Content="0.5 mm" Tag="500"/>
                        <ComboBoxItem Content="1 mm" Tag="1000" IsSelected="True"/>
                        <ComboBoxItem Content="2 mm" Tag="2000"/>
                        <ComboBoxItem Content="5 mm" Tag="5000"/>
                    </ComboBox>
                    <Border Width="1" Height="26" Margin="8,0" Background="{StaticResource DividerBrush}"/>
                    <CheckBox x:Name="ShowPrintLimitsToggle" Content="Print limits" IsChecked="True"
                              Click="OnShowPrintLimitsToggle" VerticalAlignment="Center" Margin="2,0,8,0"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              ToolTip="Show the printer's absolute printable boundary"/>
                    <CheckBox x:Name="ShowSafeAreaToggle" Content="Safe 1 mm" IsChecked="False"
                              Click="OnShowSafeAreaToggle" VerticalAlignment="Center" Margin="0,0,4,0"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              ToolTip="Show a 1 mm inset inside the absolute print limits"/>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Height="28" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/>
                    <TextBlock x:Name="StatusLabel" Text="Ready" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="PointerStatusLabel" Text="X: --  Y: --" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,14,0"/>
                    <TextBlock x:Name="SnapStatusLabel" Text="Snap: ON" Foreground="{StaticResource AccentDarkBrush}" FontSize="10" Margin="0,0,14,0"/>
                    <TextBlock x:Name="LabelSizeStatusLabel" Text="Label: --" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tool rail -->
        <Border DockPanel.Dock="Left" Width="76" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="9,13" VerticalAlignment="Top">
                <TextBlock Text="TOOLS" HorizontalAlignment="Center" FontSize="9" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                <Button Style="{StaticResource ToolBtn}" Click="OnToolSelect" ToolTip="Select (V)" x:Name="ToolSelect">
                    <StackPanel><TextBlock Text="↖" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Select" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolBtn}" Click="OnToolText" ToolTip="Text (T)" x:Name="ToolText">
                    <StackPanel><TextBlock Text="T" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Text" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolBtn}" Click="OnToolRect" ToolTip="Rectangle (R)" x:Name="ToolRect">
                    <StackPanel><TextBlock Text="□" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Shape" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolBtn}" Click="OnToolLine" ToolTip="Line (L)" x:Name="ToolLine">
                    <StackPanel><TextBlock Text="╱" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Line" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolBtn}" Click="OnToolImage" ToolTip="Image (I)" x:Name="ToolImage">
                    <StackPanel><TextBlock Text="▧" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Image" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                </Button>
                <Border Height="1" Margin="7,10" Background="{StaticResource DividerBrush}"/>
                <Button Style="{StaticResource ToolBtn}" Click="OnToolPan" ToolTip="Pan (H / Space)" x:Name="ToolPan">
                    <StackPanel><TextBlock Text="✦" Style="{StaticResource ToolbarGlyph}"/><TextBlock Text="Pan" Style="{StaticResource ToolbarCaption}"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Inspector and layers -->
        <Border DockPanel.Dock="Right" Width="292" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="14,14,12,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="2,0,2,12">
                    <TextBlock Text="INSPECTOR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="OBJECT PROPERTIES" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <TabControl Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
                            BorderBrush="{StaticResource BorderBrush}">
                    <TabItem Header="Inspector">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,10,4,4">
                            <StackPanel x:Name="InspectorPanel">
                                <TextBlock Text="No selection" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Layers">
                        <DockPanel Background="{StaticResource PanelBrush}" Margin="2,8,2,2">
                            <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <Button Style="{StaticResource InspectorActionButton}" Content="Group" Click="OnGroup" ToolTip="Group Selected (Ctrl+G)"/>
                                <Button Style="{StaticResource InspectorActionButton}" Content="Ungroup" Click="OnUngroup" ToolTip="Ungroup Selected (Ctrl+Shift+G)"/>
                                <Button Style="{StaticResource InspectorActionButton}" Content="Front" Click="OnBringToFront" ToolTip="Bring to Front"/>
                                <Button Style="{StaticResource InspectorActionButton}" Content="Up" Click="OnBringForward" ToolTip="Bring Forward"/>
                                <Button Style="{StaticResource InspectorActionButton}" Content="Down" Click="OnSendBackward" ToolTip="Send Backward"/>
                                <Button Style="{StaticResource InspectorActionButton}" Content="Back" Click="OnSendToBack" ToolTip="Send to Back"/>
                            </WrapPanel>
                            <ListBox x:Name="LayersList"
                                     SelectionMode="Extended"
                                     SelectionChanged="OnLayersSelectionChanged"
                                     Background="{StaticResource PanelBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     HorizontalContentAlignment="Stretch"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- Measured workspace -->
        <Grid Background="{StaticResource WorkspaceBrush}" x:Name="WorkspaceGrid" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1"/>
            <Canvas x:Name="HorizontalRuler" Grid.Row="0" Grid.Column="1" Background="{StaticResource PanelBrush}" ClipToBounds="True"/>
            <Canvas x:Name="VerticalRuler" Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBrush}" ClipToBounds="True"/>
            <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource WorkspaceBrush}" x:Name="CanvasHost" ClipToBounds="True"
                  PreviewMouseLeftButtonDown="OnCanvasPreviewMouseDown" MouseLeave="OnCanvasMouseLeave"
                  SizeChanged="OnCanvasHostSizeChanged">
                <skia:SKElement x:Name="CanvasElement"
                                PaintSurface="OnCanvasPaint"
                                MouseDown="OnCanvasMouseDown"
                                MouseMove="OnCanvasMouseMove"
                                MouseUp="OnCanvasMouseUp"
                                MouseWheel="OnCanvasMouseWheel"/>
                <Canvas x:Name="OverlayCanvas" Panel.ZIndex="10" IsHitTestVisible="False">
                <TextBox x:Name="TextEditOverlay"
                         Visibility="Collapsed"
                         Background="Transparent"
                         Foreground="#FF000000"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                          Padding="0"
                          AcceptsReturn="True"
                          TextWrapping="NoWrap"
                          ClipToBounds="True"
                         FocusVisualStyle="{x:Null}"
                          SelectionBrush="#663C82D7"
                          SelectionTextBrush="#FF000000"
                          VerticalContentAlignment="Top"
                          TextChanged="OnTextEditTextChanged"
                          LostFocus="OnTextEditLostFocus"
                          KeyDown="OnTextEditKeyDown"/>
                </Canvas>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
