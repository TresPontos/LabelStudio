<Window x:Class="LabelStudio.Desktop.NewLabelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="DialogWindow" Title="New Label" Width="430" Height="350" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8F6F7" Foreground="#FF282331"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize">
    <StackPanel Margin="22">
        <TextBlock x:Name="DialogEyebrow" Text="NEW LABEL" Foreground="#FFC63F78" FontSize="10" FontWeight="SemiBold"/>
        <TextBlock x:Name="DialogHeading" Text="Choose your label stock" Foreground="#FF282331" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,4"/>
        <TextBlock x:Name="DialogDescription" Text="The media profile sets the printable area and Brother QL output geometry." Foreground="#FF8B818D" FontSize="11" Margin="0,0,0,18"/>
        <TextBlock Text="MEDIA PROFILE" Foreground="#FF8B818D" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox x:Name="MediaCombo" Height="30" Margin="0,0,0,18"
                  Background="#FFFFFFFF" Foreground="#FF282331" BorderBrush="#FFD8D0D6" Padding="6,3"
                  SelectionChanged="OnMediaSelectionChanged">
            <ComboBoxItem Content="DK-22251 (62mm Continuous)" Tag="brother.dk-22251" IsSelected="True"/>
            <ComboBoxItem Content="DK-11204 (17x54mm Die-Cut)" Tag="brother.dk-11204"/>
        </ComboBox>
        <TextBlock Text="CANVAS ORIENTATION" Foreground="#FF8B818D" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox x:Name="OrientationCombo" Height="30" Margin="0,0,0,5"
                  Background="#FFFFFFFF" Foreground="#FF282331" BorderBrush="#FFD8D0D6" Padding="6,3">
            <ComboBoxItem Content="Landscape" Tag="90"/>
            <ComboBoxItem Content="Portrait" Tag="0"/>
        </ComboBox>
        <TextBlock Text="Orientation changes only the design view. Printer geometry stays matched to the installed roll."
                   TextWrapping="Wrap" Foreground="#FF8B818D" FontSize="10" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Padding="8,4" IsCancel="True"
                    Background="Transparent" BorderBrush="#FFD8D0D6" Foreground="#FF625866"/>
            <Button x:Name="ConfirmButton" Content="Create" Width="92" Padding="8,4" IsDefault="True" Click="OnCreate"
                    Background="#FFC63F78" BorderBrush="#FFC63F78" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
