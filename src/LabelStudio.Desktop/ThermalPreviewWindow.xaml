<Window x:Class="LabelStudio.Desktop.ThermalPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thermal Preview" Height="540" Width="840"
        WindowStartupLocation="CenterOwner"
        Background="#FFF0ECEF" Foreground="#FF282331"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFF8F6F7" BorderBrush="#FFD8D0D6" BorderThickness="0,0,0,1" Padding="16,11">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="THERMAL PREVIEW" Foreground="#FFC63F78" FontSize="10" FontWeight="SemiBold" Margin="0,0,20,0"/>
            <RadioButton x:Name="BlackRadio" Content="Black Plane" IsChecked="True"
                         Foreground="#FF282331" Margin="0,0,16,0" Checked="OnPlaneChanged"/>
            <RadioButton x:Name="RedRadio" Content="Red Plane" Foreground="#FF625866"
                         Checked="OnPlaneChanged" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Background="#FFE0DDE0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image x:Name="PreviewImage" Stretch="None" Margin="24"/>
        </ScrollViewer>
    </Grid>
</Window>
