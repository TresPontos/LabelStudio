<Window x:Class="LabelStudio.Desktop.PrintDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print" Height="180" Width="350"
        WindowStartupLocation="CenterOwner"
        Background="#FF2D2D30" Foreground="#FFF0F0F0"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Printer queue name:" Foreground="#FFCCCCCC" Margin="0,0,0,8"/>
        <TextBox x:Name="QueueNameBox" Height="28" Margin="0,0,0,12"
                 Background="#FF3F3F46" Foreground="White" BorderBrush="#FF555555"
                 Text="Brother QL-800" Padding="4,2"/>
        <TextBlock Text="This will send a physical print job." Foreground="#FF999999" FontSize="11" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Padding="8,4" IsCancel="True"
                    Background="Transparent" BorderBrush="#FF555555" Foreground="#FFDDDDDD"/>
            <Button Content="Print" Width="80" Padding="8,4" IsDefault="True" Click="OnPrint"
                    Background="#FF007ACC" BorderBrush="#FF007ACC" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>