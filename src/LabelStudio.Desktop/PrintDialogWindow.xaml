<Window x:Class="LabelStudio.Desktop.PrintDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print" Width="430" Height="300" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8F6F7" Foreground="#FF282331"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize">
    <StackPanel Margin="22,20,22,22">
        <TextBlock Text="PRINT LABEL" Foreground="#FFC63F78" FontSize="10" FontWeight="SemiBold"/>
        <TextBlock Text="Send to a Brother QL printer" Foreground="#FF282331" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,4"/>
        <TextBlock Text="Confirm the Windows printer queue that should receive this job." Foreground="#FF8B818D" FontSize="11" Margin="0,0,0,18"/>
        <TextBlock Text="PRINTER QUEUE" Foreground="#FF8B818D" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="QueueNameBox" Height="30" Margin="0,0,0,10"
                 Background="#FFFFFFFF" Foreground="#FF282331" BorderBrush="#FFD8D0D6"
                 Text="Brother QL-800" Padding="6,3"/>
        <TextBlock Text="This will send a physical print job." Foreground="#FF8B818D" FontSize="11" Margin="0,0,0,18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Padding="8,4" IsCancel="True"
                    Background="Transparent" BorderBrush="#FFD8D0D6" Foreground="#FF625866"/>
            <Button Content="Print" Width="80" Padding="8,4" IsDefault="True" Click="OnPrint"
                    Background="#FFC63F78" BorderBrush="#FFC63F78" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
